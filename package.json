{
  "name": "dsh-freetoken",
  "version": "0.4.1",
  "description": "Unofficial DSH plugin: deepseek-web provider bridge for development use (disabled by default).",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "llm"
  ],
  "author": "ZHANG-923-ZE",
  "homepage": "https://github.com/ZHANG-923-ZE/dsh-freetoken#readme",
  "bugs": {
    "url": "https://github.com/ZHANG-923-ZE/dsh-freetoken/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZHANG-923-ZE/dsh-freetoken.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --no-emit",
    "test": "node tests/run-offline.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.13.3"
  },
  "license": "Apache-2.0"
}
